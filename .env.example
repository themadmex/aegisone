# Copy to .env for local development. Never commit a real .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://localhost:8000

DB_HOST=localhost
DB_PORT=55432
DB_NAME=aegisone
# Runtime role (no table ownership, no BYPASSRLS)
DB_USER=aegis_app
DB_PASSWORD=aegis_app_dev
# Role that runs migrations and owns the schema
DB_OWNER_USER=aegis_owner
DB_OWNER_PASSWORD=aegis_owner_dev
# Name of the runtime role that migrations grant table access to
DB_APP_ROLE=aegis_app
DNS_CHECKS_ENABLED=0

